# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Marketing API (gasto de campañas)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=

# Meta Graph API (estadísticas de Instagram/Facebook — reemplaza a Metricool)
META_PAGE_ID=
META_IG_ACCOUNT_ID=

# Clientify
CLIENTIFY_API_KEY=
CLIENTIFY_API_BASE_URL=https://api.clientify.com/v1

# Secreto que Vercel Cron envía como "Authorization: Bearer <CRON_SECRET>"
# (se configura solo: Vercel lo agrega automáticamente si esta env var existe)
CRON_SECRET=

# API Citas SISMA (sistema clínico/de agendamiento — distinto de Clientify)
SISMA_API_BASE_URL=https://api.centrooftalmologicoebenezer.com
SISMA_API_KEY=

# API ampliado SISMA ("node", /node/swagger) — llave distinta, más
# granular, pendiente de que TIC la emita (ver solicitud del 2026-09-14).
# Sin esta variable, Venta del Día sigue mostrando agendamiento normal
# y solo desactiva asistencia/cirugía.
SISMA_NODE_API_KEY=


# URL pública del sitio — usada para armar el link de las
# invitaciones por correo (redirectTo de Supabase Auth).
NEXT_PUBLIC_SITE_URL=
